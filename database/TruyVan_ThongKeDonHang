USE DroneDeliveryDB;
GO

-- ----------------------------------------------------------------------------
-- 1. CÁC STORED PROCEDURE XEM VÀ TRUY VẤN ĐƠN HÀNG
-- ----------------------------------------------------------------------------

-- 1.1. Thủ tục xem tất cả danh sách đơn hàng (kèm tên khách hàng và trạm)
CREATE PROCEDURE sp_XemDanhSachDonHang
AS
BEGIN
    SELECT 
        o.OrderId AS [Mã Đơn],
        o.TrackingCode AS [Mã Vận Đơn],
        c.FullName AS [Tên Khách Hàng],
        s.StationName AS [Trạm Gửi],
        o.ReceiverAddress AS [Địa Chỉ Nhận],
        o.PackageWeightKg AS [Khối Lượng (Kg)],
        o.Status AS [Trạng Thái],
        o.CreatedDate AS [Ngày Tạo]
    FROM Orders o
    INNER JOIN Users c ON o.CustomerId = c.UserId
    LEFT JOIN Stations s ON o.DepartureStationId = s.StationId
    ORDER BY o.CreatedDate DESC;
END;
GO

-- 1.2. Thủ tục xem chi tiết 1 đơn hàng theo Mã Vận Đơn (TrackingCode)
CREATE PROCEDURE sp_XemChiTietDonHang
    @MaVanDon NVARCHAR(50)
AS
BEGIN
    SELECT 
        o.OrderId,
        o.TrackingCode,
        c.FullName AS TenKhachHang,
        c.PhoneNumber AS SDTKhachHang,
        o.ReceiverName AS TenNguoiNhan,
        o.ReceiverPhone AS SDTNguoiNhan,
        o.ReceiverAddress AS DiaChiGiao,
        o.DeliveryFee AS PhiGiaoHang,
        o.Status AS TrangThai,
        o.CreatedDate AS NgayTao
    FROM Orders o
    INNER JOIN Users c ON o.CustomerId = c.UserId
    WHERE o.TrackingCode = @MaVanDon;
END;
GO

-- 1.3. Thủ tục tìm kiếm đơn hàng theo Tên Khách Hàng hoặc Địa Chỉ
CREATE PROCEDURE sp_TimKiemDonHang
    @TuKhoa NVARCHAR(100)
AS
BEGIN
    SELECT 
        o.OrderId,
        o.TrackingCode,
        c.FullName AS TenKhachHang,
        o.ReceiverAddress,
        o.Status,
        o.CreatedDate
    FROM Orders o
    INNER JOIN Users c ON o.CustomerId = c.UserId
    WHERE c.FullName LIKE '%' + @TuKhoa + '%'
       OR o.ReceiverAddress LIKE '%' + @TuKhoa + '%';
END;
GO


-- ----------------------------------------------------------------------------
-- 2. CÁC VIEW THỐNG KÊ ĐƠN HÀNG (DÙNG CHO DASHBOARD BÁO CÁO)
-- ----------------------------------------------------------------------------

-- 2.1. View đếm tổng số đơn hàng và tổng doanh thu theo từng trạng thái
CREATE VIEW vw_ThongKeTheoTrangThai
AS
SELECT 
    Status AS TrangThai,
    COUNT(OrderId) AS TongSoDon,
    SUM(DeliveryFee) AS TongDoanhThu
FROM Orders
GROUP BY Status;
GO

-- 2.2. View thống kê số đơn hàng và doanh thu theo từng ngày
CREATE VIEW vw_ThongKeDonHangTheoNgay
AS
SELECT 
    CAST(CreatedDate AS DATE) AS Ngay,
    COUNT(OrderId) AS TongSoDonTrongNgay,
    SUM(DeliveryFee) AS DoanhThuTrongNgay
FROM Orders
GROUP BY CAST(CreatedDate AS DATE);
GO

-- 2.3. View thống kê số lượng đơn gửi đi từ mỗi Trạm hạ cánh
CREATE VIEW vw_ThongKeDonTheoTram
AS
SELECT 
    s.StationId AS MaTram,
    s.StationName AS TenTram,
    COUNT(o.OrderId) AS SoLuongDonGui
FROM Stations s
LEFT JOIN Orders o ON s.StationId = o.DepartureStationId
GROUP BY s.StationId, s.StationName;
GO
