-- ============================================================================
-- 1. CÁC CÂU TRUY VẤN XEM VÀ QUẢN LÝ ĐƠN HÀNG (STORED PROCEDURES)
-- ============================================================================

-- 1.1. Lấy danh sách đơn hàng có phân trang và lọc theo trạng thái
IF OBJECT_ID('sp_GetOrdersList', 'P') IS NOT NULL DROP PROCEDURE sp_GetOrdersList;
GO
CREATE PROCEDURE sp_GetOrdersList
    @Status NVARCHAR(50) = NULL,
    @PageIndex INT = 1,
    @PageSize INT = 10
AS
BEGIN
    SET NOCOUNT ON;

    SELECT 
        o.OrderId,
        o.TrackingCode,
        c.FullName AS CustomerName,
        s.StationName AS DepartureStation,
        o.ReceiverAddress,
        o.PackageWeightKg,
        o.Status,
        o.CreatedDate
    FROM Orders o
    INNER JOIN Users c ON o.CustomerId = c.UserId
    LEFT JOIN Stations s ON o.DepartureStationId = s.StationId
    WHERE (@Status IS NULL OR o.Status = @Status)
    ORDER BY o.CreatedDate DESC
    OFFSET (@PageIndex - 1) * @PageSize ROWS
    FETCH NEXT @PageSize ROWS ONLY;
END;
GO

-- 1.2. Xem chi tiết 1 đơn hàng theo OrderId hoặc TrackingCode
IF OBJECT_ID('sp_GetOrderDetail', 'P') IS NOT NULL DROP PROCEDURE sp_GetOrderDetail;
GO
CREATE PROCEDURE sp_GetOrderDetail
    @OrderId INT = NULL,
    @TrackingCode NVARCHAR(50) = NULL
AS
BEGIN
    SET NOCOUNT ON;

    SELECT 
        o.OrderId,
        o.TrackingCode,
        c.FullName AS CustomerName,
        c.PhoneNumber AS CustomerPhone,
        sDep.StationName AS DepartureStation,
        sArr.StationName AS ArrivalStation,
        o.ReceiverName,
        o.ReceiverPhone,
        o.ReceiverAddress,
        o.PackageWeightKg,
        o.DeliveryFee,
        o.EstimatedMinutes,
        o.Status,
        o.CreatedDate,
        o.CompletedDate
    FROM Orders o
    INNER JOIN Users c ON o.CustomerId = c.UserId
    LEFT JOIN Stations sDep ON o.DepartureStationId = sDep.StationId
    LEFT JOIN Stations sArr ON o.ArrivalStationId = sArr.StationId
    WHERE (@OrderId IS NOT NULL AND o.OrderId = @OrderId)
       OR (@TrackingCode IS NOT NULL AND o.TrackingCode = @TrackingCode);
END;
GO

-- 1.3. Tìm kiếm đơn hàng theo tên khách hàng hoặc địa chỉ giao
IF OBJECT_ID('sp_SearchOrders', 'P') IS NOT NULL DROP PROCEDURE sp_SearchOrders;
GO
CREATE PROCEDURE sp_SearchOrders
    @Keyword NVARCHAR(100)
AS
BEGIN
    SET NOCOUNT ON;

    SELECT 
        o.OrderId,
        o.TrackingCode,
        c.FullName AS CustomerName,
        o.ReceiverAddress,
        o.Status,
        o.CreatedDate
    FROM Orders o
    INNER JOIN Users c ON o.CustomerId = c.UserId
    WHERE c.FullName LIKE '%' + @Keyword + '%'
       OR o.ReceiverAddress LIKE '%' + @Keyword + '%'
       OR o.TrackingCode LIKE '%' + @Keyword + '%';
END;
GO


-- ============================================================================
-- 2. CÁC VIEW TRUY VẤN THỐNG KÊ BÁO CÁO (DASHBOARD ANALYTICS)
-- ============================================================================

-- 2.1. View Thống kê tổng quan đơn hàng theo trạng thái
IF OBJECT_ID('vw_OrderStatusSummary', 'V') IS NOT NULL DROP VIEW vw_OrderStatusSummary;
GO
CREATE VIEW vw_OrderStatusSummary AS
SELECT 
    Status,
    COUNT(OrderId) AS TotalOrders,
    SUM(DeliveryFee) AS TotalRevenue,
    AVG(PackageWeightKg) AS AvgPackageWeight
FROM Orders
GROUP BY Status;
GO

-- 2.2. View Thống kê doanh thu và số lượng đơn hàng theo ngày
IF OBJECT_ID('vw_DailyDeliveryStats', 'V') IS NOT NULL DROP VIEW vw_DailyDeliveryStats;
GO
CREATE VIEW vw_DailyDeliveryStats AS
SELECT 
    CAST(CreatedDate AS DATE) AS OrderDate,
    COUNT(OrderId) AS TotalOrders,
    SUM(CASE WHEN Status = 'Completed' THEN 1 ELSE 0 END) AS SuccessfulDeliveries,
    SUM(CASE WHEN Status = 'Failed' THEN 1 ELSE 0 END) AS FailedDeliveries,
    SUM(CASE WHEN Status = 'Completed' THEN DeliveryFee ELSE 0 END) AS DailyRevenue
FROM Orders
GROUP BY CAST(CreatedDate AS DATE);
GO

-- 2.3. View Thống kê tần suất sử dụng của các trạm hạ cánh (Landing Stations)
IF OBJECT_ID('vw_StationUsageStats', 'V') IS NOT NULL DROP VIEW vw_StationUsageStats;
GO
CREATE VIEW vw_StationUsageStats AS
SELECT 
    s.StationId,
    s.StationName,
    s.LocationAddress,
    COUNT(o.OrderId) AS TotalDepartures
FROM Stations s
LEFT JOIN Orders o ON s.StationId = o.DepartureStationId
GROUP BY s.StationId, s.StationName, s.LocationAddress;
GO
